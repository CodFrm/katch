env: DEV
debug: true

# source 不能省。cago 的 Config.init() 会无条件读这个键，缺失时启动直接失败
# （"config key not found: source"）。改用 etcd 时这里填 etcd 并补上连接段。
source: file

http:
  address:
    - "0.0.0.0:8080"

logger:
  level: info
  disableConsole: false
  logFile:
    enable: true
    filename: ./runtime/logs/katch.log
    # 单独收 error 及以上级别，值班时只看这一个文件即可。
    errorFilename: ./runtime/logs/katch.err.log

db:
  # 默认 sqlite：驱动是纯 Go 的 modernc.org/sqlite，不需要 cgo，落地就是一个文件。
  # 切 mysql 只改这一段：
  #   driver: "mysql"
  #   dsn: "user:pass@tcp(127.0.0.1:3306)/katch?charset=utf8mb4&parseTime=True&loc=Local"
  driver: "sqlite"
  # 两个 pragma 都不能省：
  #   journal_mode(WAL)  —— 默认的 DELETE 模式下读会阻塞写，缓存元数据是读多写少，
  #                         不开 WAL 一上并发就互相卡。
  #   busy_timeout(5000) —— sqlite 遇到锁默认**立刻**返回 SQLITE_BUSY 而不是等待，
  #                         不设这个值，并发写会直接报 "database is locked"。
  dsn: "file:./data/katch.db?_pragma=journal_mode(WAL)&_pragma=busy_timeout(5000)"
  prefix: "katch_"
  debug: false
  # sqlite 是单文件，写入本来就串行，连接数开大只会增加锁竞争。切到 mysql 时这几项
  # 要重调（副本数 × maxOpenConns ≤ 数据库最大连接数）。
  maxOpenConns: 8
  maxIdleConns: 4
  connMaxLifetime: 30m
  connMaxIdleTime: 5m

cache:
  # 缓存目录：对象本体按内容摘要存在这里，元数据在库的 cache_object 表里。
  # 它在配置文件里而不在库里，因为「进程起不来就没法从界面改」——目录不可写时
  # 服务会降级为纯透传（拉取照常，只是不缓存），那时要靠改这里把它救回来。
  # 配额、回收水位、可变对象 TTL 这些跑起来之后才生效的参数一律落库。
  dir: ./data/cache

git:
  # git 本地镜像的根目录：每个被拉过的仓库在这里有一份裸仓库。
  #
  # 它和缓存目录分开，因为两者的淘汰依据不同——对象按内容摘要 + LRU，镜像按最后
  # 访问时间、整个仓库一起删。目录不可写时 git 只穿透不建镜像（clone 照常能用，
  # 只是不加速），所以它和缓存目录一样住在配置文件里，而不是库里。
  #
  # 总配额、单仓体积上限、同步超时与同步并发是运行时项，在界面的「设置」里改。
  dir: ./data/mirrors

admin:
  # 管理接口（/api/v1/admin/*）的**初始**密钥。密钥以 bcrypt 哈希存在库的 setting
  # 表里，这里的值只在库中尚无密钥时生效一次；之后的轮换在界面上完成，改这里不会
  # 有任何效果，也不会把已经轮换过的密钥覆盖回去。
  # 留空则不设密钥：管理接口全量 401，拉取路径照常服务。
  initialKey: "change-me-before-exposing-katch"
