# katch 容器部署的配置模板。
#
# 和 configs/config.yaml.example 是**两份**：那份是本地开发与 smoke 的出厂值
# （env: DEV、日志落 ./runtime/logs），这份是跑在容器里的那一套。两份的 debug 都关着，
# 理由写在那份里。加新配置项时两边都要加——只加一边的后果是「本地好好的，部署上去
# 起不来」。
#
# 用法：
#   cp deploy/config.yaml.example deploy/config.yaml
#   # 把 admin.initialKey 换成 openssl rand -hex 24 生成的值
#   docker compose -f deploy/docker-compose.yml up -d
#
# deploy/config.yaml 被 .gitignore 挡着，理由和 configs/config.yaml 一样：里面有
# 真的管理密钥和 DSN。

# 容器里跑的是正式形态。debug 决定 gin 的模式（cago 的 mux.HTTP 只看这一个字段，
# 不看 env）：留 true 会挂上 gin.Logger 中间件，每个请求多打一行到 stdout——
# 一次 docker pull 是几十上百个请求，镜像站上这就是纯噪音。
env: prod
debug: false

# source 不能省。cago 的 Config.init() 会无条件读这个键，缺失时启动直接失败。
source: file

http:
  address:
    # 必须是 0.0.0.0 而不是 127.0.0.1：绑在回环上的话，容器外面谁也连不进来。
    - "0.0.0.0:8080"

logger:
  level: info
  # 不关 console：容器里的 stdout 是 docker logs / kubectl logs 唯一的入口，
  # 关掉就只能进容器捞文件了。
  disableConsole: false
  logFile:
    # 关掉就只剩 stdout：容器里由 runtime 收走，捞历史要去容器的日志存储里翻。
    enable: true
    # 日志落在数据卷里而不是 ./runtime/logs：容器根文件系统可以整个只读
    # （compose 的 read_only、k8s 的 readOnlyRootFilesystem），进程要写的地方
    # 就只剩这一个挂载点。
    filename: ./data/logs/katch.log
    errorFilename: ./data/logs/katch.err.log

db:
  # 默认 sqlite：驱动是纯 Go 的 modernc.org/sqlite，不需要 cgo，落地就是一个文件。
  # 切 mysql 只改这一段：
  #   driver: "mysql"
  #   dsn: "user:pass@tcp(mysql:3306)/katch?charset=utf8mb4&parseTime=True&loc=Local"
  # 注意切了 mysql 也**不能**多开副本，理由见 docs/deploy.md 的「为什么只能一个副本」。
  driver: "sqlite"
  # 三个 pragma 都不能省：
  #   journal_mode(WAL)     —— 默认的 DELETE 模式下读会阻塞写，缓存元数据是读多写少，
  #                            不开 WAL 一上并发就互相卡。
  #   busy_timeout(5000)    —— sqlite 遇到锁默认**立刻**返回 SQLITE_BUSY 而不是等待，
  #                            不设这个值，并发写会直接报 "database is locked"。
  #   synchronous(NORMAL)   —— 默认的 FULL 在 WAL 下每次提交都 fsync，而缓存正往同一块盘
  #                            写大文件，一次提交能卡几百毫秒到几秒，等锁的写还会超过上面
  #                            的 5 秒直接失败。NORMAL 只在断电或系统崩溃时可能丢最后几个
  #                            事务（进程崩溃不丢），对缓存元数据的代价是下次重新回源。
  dsn: "file:./data/katch.db?_pragma=journal_mode(WAL)&_pragma=busy_timeout(5000)&_pragma=synchronous(NORMAL)"
  prefix: "katch_"
  debug: false
  # sqlite 是单文件，写入本来就串行，连接数开大只会增加锁竞争。
  maxOpenConns: 8
  maxIdleConns: 4
  connMaxLifetime: 30m
  connMaxIdleTime: 5m

cache:
  # 缓存目录，和库文件、日志同在一个卷里。
  #
  # cache/ 和 logs/ 这两个子目录进程会自己建（cache.NewStore 和 lumberjack 都
  # MkdirAll），但 **./data 本身必须已经存在**——sqlite 不建父目录，缺了它启动就
  # panic，而且报的是 "unable to open database file: out of memory (14)"，
  # 那句话里没有一个字提到目录。镜像里 /app/data 由 Dockerfile 的 VOLUME 建好了，
  # 所以正常挂卷不会碰到；换挂载路径时记得这一条。
  #
  # 缓存目录单独不可写是另一回事：那时服务降级为纯透传（拉取照常，只是不缓存），
  # 不会起不来，症状是命中率一直是 0。
  #
  # 配额、回收水位、可变对象 TTL 是运行时项，在界面的「设置」里改，不在这里。
  dir: ./data/cache

git:
  # git 本地镜像的根目录，和缓存目录并排住在同一个卷里。
  #
  # 分开两个目录是因为淘汰依据不同：对象按内容摘要 + LRU，镜像按最后访问时间、
  # 整个仓库一起删。这里不可写时 git 只穿透不建镜像，clone 照常能用。
  #
  # 总配额、单仓体积上限、同步超时与同步并发是运行时项，在界面的「设置」里改。
  dir: ./data/mirrors

admin:
  # **部署前必须改掉**。生成一个：openssl rand -hex 24
  #
  # 这是**初始**密钥：它只在库中尚无密钥时落一次，之后的轮换在界面上完成。
  # 也就是说改这里救不回一个已经轮换过又忘掉的密钥——那种情况只能清掉 setting 表里
  # 的 admin_key_hash。留空则不设密钥：管理接口全量 401，拉取路径照常服务。
  initialKey: "change-me-before-exposing-katch"
