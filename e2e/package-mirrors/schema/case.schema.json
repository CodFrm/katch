{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CodFrm/katch/e2e/package-mirrors/schema/case.schema.json",
  "title": "katch package mirror client case",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "image", "setup", "run", "assert", "required_upstreams"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "image": {
      "type": "string",
      "pattern": "^[A-Za-z0-9./_-]+(?::[A-Za-z0-9._-]+|@sha256:[a-f0-9]{64})$",
      "not": {"pattern": ":latest$"}
    },
    "privileged": {
      "type": "boolean",
      "default": false,
      "description": "Run the pinned registry client with full container privileges and force its resolver to bounded loopback-only DNS."
    },
    "allow_blocked_dns_probe": {
      "type": "boolean",
      "description": "Accept Docker's blocked route probe only when it connects to the exact Katch IP on DNS port 53 and returns zero."
    },
    "allow_musl_route_probe": {
      "type": "boolean",
      "description": "Accept APK's musl route probe only when connect targets the exact Katch IP on port 65535 and returns zero."
    },
    "setup": {"type": "string", "minLength": 1},
    "run": {"type": "string", "minLength": 1},
    "assert": {"type": "string", "minLength": 1},
    "required_upstreams": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"name": {"const": "docker-registry-regression"}},
        "required": ["name"]
      },
      "then": {
        "properties": {"allow_blocked_dns_probe": {"const": true}},
        "required": ["allow_blocked_dns_probe"]
      },
      "else": {
        "not": {"required": ["allow_blocked_dns_probe"]}
      }
    },
    {
      "if": {
        "properties": {"name": {"const": "apk"}},
        "required": ["name"]
      },
      "then": {
        "properties": {"allow_musl_route_probe": {"const": true}},
        "required": ["allow_musl_route_probe"]
      },
      "else": {
        "not": {"required": ["allow_musl_route_probe"]}
      }
    }
  ]
}
