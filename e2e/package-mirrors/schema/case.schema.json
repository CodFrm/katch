{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CodFrm/katch/e2e/package-mirrors/schema/case.schema.json",
  "title": "katch package mirror client case",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "image", "setup", "run", "assert", "required_upstreams"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "image": {
      "type": "string",
      "pattern": "^[A-Za-z0-9./_-]+(?::[A-Za-z0-9._-]+|@sha256:[a-f0-9]{64})$",
      "not": {"pattern": ":latest$"}
    },
    "privileged": {
      "type": "boolean",
      "default": false,
      "description": "Run the pinned registry client with full container privileges and force its resolver to bounded loopback-only DNS."
    },
    "setup": {"type": "string", "minLength": 1},
    "run": {"type": "string", "minLength": 1},
    "assert": {"type": "string", "minLength": 1},
    "required_upstreams": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$"
      }
    }
  }
}
